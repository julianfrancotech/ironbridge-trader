# Copy to .env and fill in to enable the Claude tool-using agent.
# Without this set, the app still runs end-to-end (fetch data, train,
# paper-trade, dashboard) using the deterministic threshold service.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: only needed if you set data_provider=alpaca and/or
# execution_provider=alpaca_paper in the dashboard's Settings tab (both
# default to the free yfinance/PaperBroker path, so nothing here is
# required to run this app). Free to create at https://alpaca.markets --
# use PAPER trading keys, not live ones. Never entered through the
# dashboard on purpose, same reasoning as ANTHROPIC_API_KEY above.
ALPACA_API_KEY=your-alpaca-paper-key-here
ALPACA_SECRET_KEY=your-alpaca-paper-secret-here
